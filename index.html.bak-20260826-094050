,"to":941,"page":421},{"n":174,"text":"व्योमकेशी विमानस्था वज्रिणी वामकेश्वरी । पञ्चयज्ञप्रिया पञ्चप्रेतमञ्चाधिशायिनी","from":942,"to":947,"page":421},{"n":175,"text":"पञ्चमी पञ्चभूतेशी पञ्चसङ्ख्योपचारिणी । शाश्वती शाश्वतैश्वर्या शर्मदा शंभुमोहिनी","from":948,"to":954,"page":422},{"n":176,"text":"धरा धरसुता धन्या धर्मिणी धर्मवर्धिनी । लोकातीता गुणातीता सर्वातीता शमात्मिका","from":955,"to":963,"page":422},{"n":977,"text":"बन्धककुसुमप्रख्या बाला लीलाविनोदिनी । सुमङ्गली सुखकरी सुवेषाढ्या सुवासिनी","from":964,"to":970,"page":422},{"n":178,"text":"सुवासिन्यर्चनप्रीता ऽऽशोभना शुद्धमानसा । बिन्दुतर्पणसंतुष्टा पूर्वजा त्रिपुराम्बिका","from":971,"to":976,"page":422},{"n":179,"text":"दशमुद्रासमाराध्या त्रिपुरा श्रीवशंकरी । ज्ञानमुद्रा ज्ञानगम्या ज्ञातृज्ञेयस्वरूपिणी","from":977,"to":981,"page":422},{"n":180,"text":"योनिमुद्रा त्रिखण्डेशी त्रिगुणा ऽम्बा त्रिकोणगा । अनघा ऽद्भुतचारित्रा वाञ्छितार्थप्रदायिनी","from":982,"to":989,"page":422},{"n":181,"text":"अभ्यासातिशयज्ञाता षडध्वातीतरूपिणी । अव्याजकरुणामूर्तिर ज्ञानध्वान्तदीपिका","from":990,"to":993,"page":422},{"n":182,"text":"आबालगोपविदिता सर्वानुल्लङ्घयशासना । श्रीचक्रराजनिलया श्रीमत्रिपुरसुन्दरी","from":994,"to":997,"page":422},{"n":182,"text":"श्रीशिवा शिवशक्त्यैक्यरूपिणी ललिताम्बिका","from":998,"to":1000,"page":422}],"stats":{"dev_pages":31,"com_pages":332,"heads":945,"heads_repaired":[44,430,838],"verses":179,"tokens":1137,"decades":98,"checkable":930,"strong":821,"weak":43,"poor":66,"multiword":28,"unmapped":0,"inexact":55,"glossary":1161,"pada_status":"ready","pada_shown":473,"pada_held":61,"pada_none":466,"pada_gate":0.75,"pada_trusted":199,"pada_gold":42,"wbw_done":68}};
const NAMAS = DATA.namas, VERSES = DATA.verses, STRONG = 0.75;

function esc(s) {
  return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function padaLine(s) {
  if (!s.pada || !s.pada.length) return '';
  const sep = '<span class="sep">+</span>';
  const dev = s.pada.map(p => '<span class="pd">' + esc(p.dev) + '</span>').join(sep);
  const rom = s.pada.map(p => esc(p.iast)).join(' + ');
  const tip = s.wbw
    ? 'Pada-cheda from the hand-edited word-by-word notes.'
    : 'Pada-cheda, computed against an attested Sanskrit lexicon (confidence '
      + s.pconf + '). Withheld where uncertain.';
  return '<span class="pada" title="' + tip + '">'
       + dev + '  <span class="pi">' + rom + '</span></span>';
}

const WMARK = '<span class="wmark" title="Word-by-word analysis available">'
            + '\u2726</span>';

function wbwHtml(s) {
  const w = s.wbw;
  if (!w) return '';
  const sep = '<span class="sep">-</span>';
  const out = ['<div class="wbw">'];

  out.push('<div class="blk split"><span class="lbl">Pada-cheda</span>'
    + w.split.split('-').map(p => '<span class="dv">' + esc(p) + '</span>').join(sep)
    + '<span class="pi">' + esc(w.splitIast) + '</span></div>');

  out.push('<div class="blk"><span class="lbl">Word by word</span><dl>'
    + w.words.map(x =>
        '<dt>' + esc(x.dev)
        + (x.iast ? '<span class="wi">' + esc(x.iast) + '</span>' : '')
        + '</dt><dd>' + esc(x.gloss) + '</dd>').join('')
    + '</dl></div>');

  if (w.vigraha && w.vigraha.length) {
    out.push('<div class="blk vig"><span class="lbl">Vigraha</span>'
      + w.vigraha.map(v => '<span class="dv">' + esc(v) + '</span>').join('')
      + '</div>');
  }

  out.push('<div class="blk mean"><span class="lbl">Meaning</span>'
    + esc(w.meaning) + '</div>');

  if (w.note) {
    out.push('<div class="blk wnote"><span class="lbl">Note</span>'
      + w.note.split(/\n\s*\n/).map(p => '<p>' + esc(p) + '</p>').join('')
      + '</div>');
  }

  out.push('</div>');
  return out.join('');
}

function render() {
  const q = document.getElementById('q').value.trim().toLowerCase();
  const out = [];
  let shown = 0;
  for (const nm of NAMAS) {
    if (q && !nm.gloss.toLowerCase().includes(q)
           && !nm.iast.toLowerCase().includes(q)
           && !nm.dev.includes(q)
           && !wbwQuery(nm).includes(q)
           && String(nm.n) !== q) continue;
    shown++;
    out.push(
      '<div class="row" onclick="openCard(' + nm.n + ')">' +
        '<span class="num' + (nm.sure ? '' : ' inferred') + '">' + nm.n + '.</span>' +
        '<span class="stack">' +
          '<span class="iast">' + esc(nm.iast) +
            (nm.wbw ? WMARK : '') + '</span>' +
          padaLine(nm) +
          '<span class="gloss' + (nm.gloss ? '' : ' empty') + '">' +
            (nm.gloss ? esc(nm.gloss) : 'heading lost to OCR') +
          '</span>' +
        '</span>' +
      '</div>');
  }
  document.getElementById('rows').innerHTML = out.join('');
  const withPada = NAMAS.filter(x => x.pada && x.pada.length).length;
  const withWbw = NAMAS.filter(x => x.wbw).length;
  document.getElementById('count').textContent =
    shown + ' of 1000 · ' + withPada + ' with pada-cheda · '
    + withWbw + ' with word-by-word';
}

// Lower-cased haystack of the word-by-word text, built once per nama.
function wbwQuery(nm) {
  if (nm._wq === undefined) {
    const w = nm.wbw;
    nm._wq = !w ? '' : [w.split, w.splitIast, w.meaning, w.note || '',
      (w.vigraha || []).join(' '),
      w.words.map(x => x.dev + ' ' + (x.iast || '') + ' ' + x.gloss).join(' ')
    ].join(' ').toLowerCase();
  }
  return nm._wq;
}

let cardNama = 0, open = new Set();

function openCard(n) {
  cardNama = n;
  open = new Set([n]);
  document.getElementById('backdrop').classList.add('open');
  draw();
}
function closeCard() {
  document.getElementById('backdrop').classList.remove('open');
  cardNama = 0;
}
function step(d) {
  const n = cardNama + d;
  if (n >= 1 && n <= 1000) openCard(n);
}
function toggleSec(n) {
  if (open.has(n)) open.delete(n); else open.add(n);
  draw(true);
}

function draw(keepScroll) {
  const nm = NAMAS[cardNama - 1];
  const v = nm.v >= 0 ? VERSES[nm.v] : null;
  const box = document.getElementById('c-sections');
  const scroll = keepScroll ? box.scrollTop : null;

  document.getElementById('c-title').textContent = 'Nama ' + nm.n + ' of 1000';
  document.getElementById('c-sub').textContent = v
    ? 'Sloka ' + v.n + ' \u00b7 names ' + v.from + '\u2013' + v.to +
      ' \u00b7 p.' + v.page
    : 'sloka not located';

  const verseEl = document.getElementById('c-verse');
  if (v && v.text) {
    verseEl.className = 'verse';
    verseEl.innerHTML = esc(v.text) +
      '<span class="vnum">\u0965 ' + v.n + ' \u0965</span>' +
      (v.combined
        ? '<div class="combined"><span class="lbl">Combined meaning</span>' +
          esc(v.combined) + '</div>'
        : '');
  } else {
    verseEl.className = 'verse missing';
    verseEl.textContent =
      'The sloka carrying this nama was not located in the OCR of the ' +
      'Devanagari pages, so no verse is shown rather than a guessed one.';
  }

  const lo = v ? v.from : nm.n, hi = v ? Math.min(v.to, 1000) : nm.n;
  const rows = [];
  for (let i = lo; i <= hi; i++) {
    const s = NAMAS[i - 1];
    const isOpen = open.has(i), isCur = i === cardNama;
    let body = s.body
      ? (s.wbw ? '<div class="srule">Bhāskararāya</div>' : '')
        + '<div class="bhk">' + esc(s.body) + '</div>'
      : '';
    if (!s.sure) {
      body = '<div class="note">The heading for this nama was lost to OCR. ' +
             'The passage below is the commentary slice that contains it, ' +
             'opening at nama ' + s.host + '.</div>' + body;
    }
    if (!s.body) {
      body = '<div class="note">Bhaskararaya glosses this nama in the ' +
             'heading alone; the book carries no further commentary on it.' +
             '</div>';
    }
    body = wbwHtml(s) + body;
    const shaky = s.fit > 0 && s.fit < STRONG ? ' shaky' : '';
    const shakyTip = shaky
      ? ' title="This nama could not be matched confidently to a word of the ' +
        'stotra, so the Devanagari shown may belong to a neighbour."' : '';
    rows.push(
      '<div class="sec' + (isOpen ? ' open' : '') + (isCur ? ' current' : '') +
           '" id="sec-' + i + '">' +
        '<div class="sec-head" onclick="toggleSec(' + i + ')">' +
          '<span class="caret">' + (isOpen ? '\u25be' : '\u25b8') + '</span>' +
          '<span class="num' + (s.sure ? '' : ' inferred') + '">' + i + '.</span>' +
          '<span class="stack">' +
            '<span class="dev">' + esc(s.dev) + '</span>' +
            '<span class="iast' + shaky + '"' + shakyTip + '>' +
              esc(s.iast) + (s.wbw ? WMARK : '') + '</span>' +
            padaLine(s) +
            '<span class="gloss">' +
              (s.gloss ? esc(s.gloss) : 'heading lost to OCR') +
            '</span>' +
          '</span>' +
        '</div>' +
        '<div class="sec-body">' + body + '</div>' +
      '</div>');
  }
  box.innerHTML = rows.join('');

  document.getElementById('c-foot').textContent =
    'Commentary p.' + nm.cpage + (v ? ' \u00b7 Sanskrit p.' + v.page : '');
  document.getElementById('c-prev').disabled = cardNama <= 1;
  document.getElementById('c-next').disabled = cardNama >= 1000;

  if (scroll !== null) {
    box.scrollTop = scroll;
  } else {
    const cur = document.getElementById('sec-' + cardNama);
    if (cur) box.scrollTop = cur.offsetTop - box.offsetTop;
  }
}

document.addEventListener('keydown', e => {
  if (e.target.tagName === 'INPUT') return;
  if (!cardNama) return;
  if (e.key === 'Escape')     closeCard();
  if (e.key === 'ArrowLeft')  step(-1);
  if (e.key === 'ArrowRight') step(1);
});

render();
</script>
</body>
</html>
