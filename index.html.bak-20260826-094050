<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lalita Sahasranama &mdash; Nama Cards</title>
<style>
  :root {
    --bg:#14100c; --panel:#1d1813; --line:#3a2f22;
    --gold:#c8860a; --gold-dim:#8a6410;
    --ink:#f0e6d3; --ink-dim:#a89880;
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font:15px/1.65 Georgia,"Times New Roman",serif; }
  header {
    position:sticky; top:0; z-index:5; background:var(--panel);
    border-bottom:1px solid var(--line); padding:14px 20px;
    display:flex; gap:16px; align-items:center; flex-wrap:wrap;
  }
  h1 { font-size:1.05rem; margin:0; color:var(--gold); font-weight:normal;
       letter-spacing:.06em; }
  input {
    background:#100d0a; border:1px solid var(--line); color:var(--ink);
    padding:7px 11px; border-radius:3px; font:inherit; font-size:.88rem;
    min-width:240px; flex:1; max-width:420px;
  }
  input:focus { outline:none; border-color:var(--gold); }
  .count { color:var(--ink-dim); font-size:.8rem; }

  #rows { max-width:920px; margin:0 auto; padding:8px 20px 60px; }
  .row { display:flex; gap:12px; align-items:baseline; padding:8px 10px;
         border-bottom:1px solid rgba(58,47,34,.5); cursor:pointer; }
  .row:hover { background:rgba(200,134,10,.10); }
  .row .num { color:var(--gold); font-size:.8rem; min-width:3.2em;
              text-align:right; flex-shrink:0; }
  .row .num.inferred { color:var(--gold-dim); font-style:italic; }
  .row .stack { display:flex; flex-direction:column; gap:1px; }
  .row .iast { font-size:.92rem; color:#f7ecd6; font-style:italic; }
  .row .gloss { font-size:.82rem; color:var(--ink-dim); }
  .row .pada, .sec-head .pada { font-size:.8rem; color:#9fb8a0; }
  .row .pada .pd, .sec-head .pada .pd {
      font-family:"Nirmala UI","Noto Sans Devanagari",serif; font-size:.92rem; }
  .row .pada .sep, .sec-head .pada .sep {
      color:var(--gold-dim); padding:0 .18em; }
  .row .pada .pi, .sec-head .pada .pi { font-style:italic; opacity:.85; }
  .row .gloss.empty { font-style:italic; }

  #backdrop { display:none; position:fixed; inset:0; z-index:10;
              background:rgba(8,6,4,.78); padding:24px; }
  #backdrop.open { display:flex; align-items:center; justify-content:center; }
  #card { background:var(--panel); border:1px solid var(--line);
          border-radius:5px; width:min(820px,100%); max-height:min(88vh,100%);
          display:flex; flex-direction:column;
          box-shadow:0 18px 50px rgba(0,0,0,.6); }
  .card-head { padding:14px 18px; border-bottom:1px solid var(--line);
               display:flex; align-items:center; gap:14px; flex-wrap:wrap;
               flex-shrink:0; }
  .card-head .title { color:var(--gold); font-size:.95rem; }
  .card-head .sub { color:var(--ink-dim); font-size:.78rem; }
  .card-head .spacer { flex:1; }
  .card-head button { background:transparent; border:1px solid var(--line);
                      color:var(--ink-dim); border-radius:3px; padding:4px 10px;
                      font:inherit; font-size:.8rem; cursor:pointer; }
  .card-head button:hover:not(:disabled) { border-color:var(--gold);
                                           color:var(--gold); }
  .card-head button:disabled { opacity:.3; cursor:default; }

  .verse { padding:20px 22px; border-bottom:1px solid var(--line);
           flex:0 0 auto; max-height:34vh; overflow-y:auto; font-size:1.22rem; line-height:1.95; color:#f7ecd6;
           font-family:"Nirmala UI","Noto Sans Devanagari",serif; }
  .verse .vnum { color:var(--gold-dim); font-size:.72rem; display:block;
                 margin-top:8px; letter-spacing:.08em;
                 font-family:Georgia,serif; }
  .verse.missing { color:var(--ink-dim); font-size:.86rem; font-style:italic;
                   line-height:1.6; font-family:Georgia,serif; }

  /* min-height:0 is load-bearing. In a column flex container an item's
     automatic minimum size is its content height, so without this .sections
     refuses to shrink, no scrollbar appears, and long commentary is clipped
     by the card's max-height. */
  .sections { flex:1 1 auto; min-height:0; overflow-y:auto;
              overscroll-behavior:contain; padding:6px 0 14px; }
  .sec { border-bottom:1px solid rgba(58,47,34,.45); }
  .sec-head { display:flex; gap:10px; align-items:baseline; padding:10px 20px;
              cursor:pointer; }
  .sec-head:hover { background:rgba(200,134,10,.08); }
  .sec-head .caret { color:var(--gold-dim); font-size:.7rem; width:1em;
                     flex-shrink:0; }
  .sec-head .num { color:var(--gold); font-size:.8rem; min-width:3.2em;
                   text-align:right; flex-shrink:0; }
  .sec-head .stack { display:flex; flex-direction:column; gap:2px; }
  .sec-head .dev { font-size:1.02rem; color:#fff5e2;
                   font-family:"Nirmala UI","Noto Sans Devanagari",serif; }
  .sec-head .iast { font-size:.86rem; color:var(--gold); font-style:italic; }
  .sec-head .iast.shaky { border-bottom:1px dotted var(--gold-dim);
                          color:var(--gold-dim); }
  .sec-head .gloss { font-size:.82rem; color:var(--ink-dim); }
  .sec-head .pada { font-size:.8rem; color:#9fb8a0; }
  .sec-head .pada .pd { font-family:"Nirmala UI","Noto Sans Devanagari",serif;
                        font-size:.92rem; }
  .sec-head .pada .sep { color:var(--gold-dim); padding:0 .18em; }
  .sec-head .pada .pi { font-style:italic; opacity:.85; }
  .sec.current { background:rgba(200,134,10,.07); }
  .sec-body { display:none; padding:2px 20px 18px 20px; margin-left:4.4em;
              font-size:.88rem; color:#e3d8c4; }
  .bhk { white-space:pre-wrap; }
  .sec.open .sec-body { display:block; }
  .note { color:var(--gold-dim); font-size:.76rem; font-style:italic;
          margin-bottom:10px; padding-bottom:8px;
          border-bottom:1px dotted var(--line); }
  /* Word-by-word block: hand-edited pada-cheda, glosses, vigraha, meaning. */
  .wbw { margin:2px 0 4px; }
  .wbw .blk { margin-top:11px; }
  .wbw .lbl { display:block; font-family:Georgia,serif; font-size:.68rem;
              letter-spacing:.13em; text-transform:uppercase;
              color:var(--gold-dim); margin-bottom:3px; }
  .wbw .dv { font-family:"Nirmala UI","Noto Sans Devanagari",serif;
             color:#f7ecd6; }
  .wbw .split .dv { font-size:1.06rem; }
  .wbw .split .sep { color:var(--gold-dim); padding:0 .16em; }
  .wbw .split .pi { display:block; margin-top:1px; font-size:.8rem;
                    font-style:italic; color:var(--ink-dim); }
  .wbw dl { display:grid; grid-template-columns:auto 1fr; gap:4px 16px;
            margin:0; }
  .wbw dt { font-family:"Nirmala UI","Noto Sans Devanagari",serif;
            font-size:1.02rem; color:var(--gold); text-align:right; }
  .wbw dt .wi { display:block; font-family:Georgia,serif; font-size:.72rem;
                font-style:italic; color:var(--gold-dim); }
  .wbw dd { margin:0; font-size:.85rem; color:#e3d8c4; }
  .wbw .vig .dv { display:block; font-size:1.02rem; line-height:1.7; }
  .wbw .mean { font-size:.95rem; color:#f7ecd6; line-height:1.7; }
  .wbw .wnote { font-size:.8rem; color:var(--ink-dim); line-height:1.7; }
  .wbw .wnote p { margin:0 0 6px; }
  .wbw .wnote p:last-child { margin-bottom:0; }
  .srule { display:flex; align-items:center; gap:9px; margin:16px 0 9px;
           font-family:Georgia,serif; font-size:.68rem; letter-spacing:.13em;
           text-transform:uppercase; color:var(--gold-dim); }
  .srule::after { content:""; flex:1; height:1px; background:var(--line); }
  .wmark { color:var(--gold-dim); font-family:Georgia,serif; font-size:.7rem;
           font-style:normal; padding-left:.45em; vertical-align:.15em; }
  .combined { margin-top:14px; padding-top:11px;
              border-top:1px dotted var(--line); font-family:Georgia,serif;
              font-size:.86rem; line-height:1.7; color:var(--ink-dim); }
  .combined .lbl { display:block; font-size:.68rem; letter-spacing:.13em;
                   text-transform:uppercase; color:var(--gold-dim);
                   margin-bottom:3px; }
  .card-foot { padding:10px 18px; border-top:1px solid var(--line);
               color:var(--ink-dim); font-size:.76rem; flex-shrink:0; }
</style>
</head>
